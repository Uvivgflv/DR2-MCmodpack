{
  "env": {
    "browser": false,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parseOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "prefer-const": "error",
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "indent": ["error", 2],
    "comma-dangle": ["error", "never"]
  },
  "globals": {
    "ServerEvents": "readonly",
    "StartupEvents": "readonly",
    "Item": "readonly",
    "Block": "readonly",
    "globalThis": "writable",
    "console": "readonly",
    "Ingredient": "readonly",
    "LootJS": "readonly",
    "JsonIO": "readonly",
    "WorldgenEvents": "readonly",
    "ItemEvents": "readonly",
    "JEIEvents": "readonly",
    "PlayerEvents": "readonly"
  }
}