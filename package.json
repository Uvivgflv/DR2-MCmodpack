{
   "name": "dark-realm-modpack",
   "version": "1.0.0",
   "description": "KubeJS scripts for Dark Realm modpack",
   "keywords": [
      "minecraft",
      "kubejs",
      "modpack"
   ],
   "homepage": "https://github.com/Uvivgflv/DR2-MCmodpack#readme",
   "bugs": {
      "url": "https://github.com/Uvivgflv/DR2-MCmodpack/issues"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Uvivgflv/DR2-MCmodpack.git"
   },
   "license": "MIT",
   "author": "UVIV",
   "type": "commonjs",
   "main": "index.js",
   "directories": {
      "doc": "docs"
   },
   "scripts": {
      "format": "prettier --write \"kubejs/**/*.js\" \"scripts/**/*.js\"",
      "format:check": "prettier --check kubejs/**/*.js scripts/**/*.js",
      "lint": "eslint kubejs/**/*.js",
      "lint:fix": "eslint kubejs/**/*.js --fix",
      "init": "node scripts/init.js",
      "backup": "node scripts/backup.js",
      "deploy": "node scripts/deploy.js",
      "test": "node scripts/test.js",
      "search": "node scripts/inserter.js",
      "launch": "node scripts/launch.js",
      "git:init": "node scripts/git_init.js",
      "git:status": "git status",
      "git:add": "git add .",
      "git:commit": "git commit -m",
      "clean": "node scripts/clean.js",
      "build": "npm run format && npm run lint",
      "dev": "echo 'Development mode - watching files...'",
      "git:check": "node scripts/check_git_setup.js",
      "git:setup": "node scripts/git_setup.js"
   },
